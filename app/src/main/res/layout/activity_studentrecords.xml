<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/rootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#EEF3F9">

    <ScrollView
        android:id="@+id/scrollView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:clipToPadding="false"
        tools:ignore="UselessParent">

        <LinearLayout
            android:id="@+id/studentCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="16dp"
            android:orientation="vertical"
            android:background="#FFFFFF"
            android:elevation="3dp"
            android:padding="16dp">


            <LinearLayout
                android:id="@+id/dragHeader"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="#315F91"
                android:padding="16dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Student Records"
                    android:textColor="#FFFFFF"
                    android:textSize="23sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Student Information System"
                    android:textColor="#DDE9F7"
                    android:textSize="14sp" />

            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="12dp"
                android:text="STUDENT INFORMATION"
                android:textColor="#315F91"
                android:textSize="14sp"
                android:textStyle="bold" />


            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Student ID"
                android:textColor="#27384B"
                android:textSize="14sp" />

            <EditText
                android:id="@+id/etStudentID"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="4dp"
                android:hint="Enter student ID"
                android:inputType="text"
                android:singleLine="true"
                android:padding="10dp"
                android:textColor="#202B38"
                android:textColorHint="#8794A5"
                android:backgroundTint="#7898BC" />


            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Student Name"
                android:textColor="#27384B"
                android:textSize="14sp" />

            <EditText
                android:id="@+id/etStudentName"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="4dp"
                android:hint="Enter full name"
                android:inputType="textPersonName|textCapWords"
                android:singleLine="true"
                android:padding="10dp"
                android:textColor="#202B38"
                android:textColorHint="#8794A5"
                android:backgroundTint="#7898BC" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Grade Level"
                android:textColor="#27384B"
                android:textSize="14sp" />

            <EditText
                android:id="@+id/etGradeLevel"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="4dp"
                android:hint="Enter grade level"
                android:inputType="textCapWords"
                android:singleLine="true"
                android:padding="10dp"
                android:textColor="#202B38"
                android:textColorHint="#8794A5"
                android:backgroundTint="#7898BC" />


            <CheckBox
                android:id="@+id/cbActive"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:buttonTint="#315F91"
                android:checked="true"
                android:text="Active record"
                android:textColor="#27384B"
                android:textSize="14sp" />


            <Button
                android:id="@+id/btnAdd"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="12dp"
                android:backgroundTint="#315F91"
                android:text="ADD STUDENT"
                android:textColor="#FFFFFF" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="4dp">

                <Button
                    android:id="@+id/btnUpdate"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="4dp"
                    android:backgroundTint="#DCE7F4"
                    android:text="UPDATE"
                    android:textColor="#244D7A" />

                <Button
                    android:id="@+id/btnClear"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:layout_marginStart="4dp"
                    android:backgroundTint="#E6EAF0"
                    android:text="CLEAR"
                    android:textColor="#27384B" />

            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="20dp"
                android:background="#DCE3EC" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="STUDENT LIST"
                android:textColor="#315F91"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvRecordCount"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Total students: 0"
                android:textColor="#69788B"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/tvRecords"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="#F3F6FA"
                android:padding="12dp"
                android:text="No student records yet."
                android:textColor="#27384B"
                android:textSize="14sp" />

        </LinearLayout>

    </ScrollView>

</FrameLayout>
